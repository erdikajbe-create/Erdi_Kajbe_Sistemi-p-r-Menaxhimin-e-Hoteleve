{
  "info": {
    "name": "HotelHub API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Endpoint-et JSON të HotelHub. Sesioni ruhet me cookie; token-i CSRF merret automatikisht (pre-request script). Fillo me 'Auth / Login recepsionist'."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "csrf",
      "value": ""
    },
    {
      "key": "reservationId",
      "value": "1"
    },
    {
      "key": "checkIn",
      "value": "2026-12-12"
    },
    {
      "key": "checkOut",
      "value": "2026-12-15"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Merr token-in CSRF një herë për sesion dhe e dërgon në header për POST/PATCH/DELETE (KJF04)",
          "if (pm.request.method !== 'GET') {",
          "  const send = () => pm.request.headers.upsert({ key: 'X-CSRF-Token', value: pm.collectionVariables.get('csrf') });",
          "  if (pm.collectionVariables.get('csrf')) { send(); } else {",
          "    pm.sendRequest(pm.collectionVariables.get('baseUrl') + '/api/auth/csrf', (err, res) => {",
          "      pm.collectionVariables.set('csrf', res.json().data.csrf_token); send();",
          "    });",
          "  }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "exec": [
          "// pas login-it sesioni rigjenerohet dhe vjen token i ri",
          "const body = pm.response.json ? (() => { try { return pm.response.json(); } catch (e) { return null; } })() : null;",
          "if (body && body.data && body.data.csrf_token) pm.collectionVariables.set('csrf', body.data.csrf_token);",
          "if (body && body.data && body.data.id && pm.request.method === 'POST' && pm.request.url.getPath() === '/api/reservations') pm.collectionVariables.set('reservationId', body.data.id);",
          "pm.test('Format i njësuar', () => pm.expect(body === null || typeof body.success === 'boolean').to.be.true);"
        ]
      }
    }
  ],
